<div class="flex flex-col items-center justify-center min-h-full p-6 bg-space">
    <div class="text-center max-w-sm">
        <h1 class="text-5xl font-bold text-gold glow-gold-intense mb-2">Soc Ops</h1>
        <p class="text-2xl text-cyan mb-8">Social Bingo</p>

        <div class="bg-space-light rounded-lg p-6 shadow-glow-cyan border-2 border-glow-cyan mb-8">
            <h2 class="font-semibold text-gold mb-3 text-lg glow-gold">How to play</h2>
            <ul class="text-left text-cyan-light text-sm space-y-2">
                <li>• Find people who match the questions</li>
                <li>• Tap a square when you find a match</li>
                <li>• Get 5 in a row to win!</li>
            </ul>
        </div>

        <button
            @onclick="OnStart"
            class="w-full bg-gold text-space font-semibold py-4 px-8 rounded-lg text-lg hover:shadow-glow-gold-intense transition-all duration-150 transform hover:scale-105">
            Start Game
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
