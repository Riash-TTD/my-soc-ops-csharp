<div class="landing-starfield min-h-full">
    <main class="landing-shell">
        <section class="landing-hero landing-reveal">
            <p class="landing-kicker">Social Bingo // Room Scanner Online</p>
            <h1 class="landing-title text-gold glow-gold-intense">Soc Ops</h1>
            <p class="landing-subtitle text-cyan-light">
                Find your allies across the room. Match prompts, mark coordinates, and complete a line before the signal fades.
            </p>

            <div class="landing-actions">
                <button
                    @onclick="OnStart"
                    class="landing-primary-button bg-gold text-space font-semibold transition-all duration-150 transform hover:scale-105">
                    Start Mission
                </button>
                <span class="landing-note text-cyan-muted">25 prompts. 5 in a row. One room-wide search.</span>
            </div>
        </section>

        <aside class="landing-panel landing-reveal delay-200">
            <div class="landing-panel-header">
                <span class="landing-panel-eyebrow text-cyan-muted">Mission Briefing</span>
                <span class="landing-status text-gold">Ready</span>
            </div>

            <div class="landing-radar" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <ol class="landing-steps text-cyan-light">
                <li><strong>Find</strong> people who match the prompts.</li>
                <li><strong>Mark</strong> a square when you confirm a match.</li>
                <li><strong>Win</strong> by completing any 5-square line.</li>
            </ol>

            <div class="landing-stats">
                <div>
                    <strong class="text-gold">5x5</strong>
                    <span>Grid</span>
                </div>
                <div>
                    <strong class="text-gold">Free</strong>
                    <span>Center</span>
                </div>
                <div>
                    <strong class="text-gold">Live</strong>
                    <span>Room Play</span>
                </div>
            </div>
        </aside>
    </main>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
