<div class="fixed inset-0 bg-black/70 flex items-center justify-center p-4 z-50">
    <div class="bg-space-light rounded-xl p-6 max-w-xs w-full text-center shadow-glow-gold-intense border-2 border-glow-gold animate-[bounce_0.5s_ease-out] animate-pulse-glow">
        <div class="text-5xl mb-4">🎉</div>
        <h2 class="text-4xl font-bold text-gold glow-gold-intense mb-2">BINGO!</h2>
        <p class="text-cyan-light mb-6 text-lg">You completed a line!</p>

        <button
            @onclick="OnDismiss"
            class="w-full bg-gold text-space font-semibold py-3 px-6 rounded-lg hover:shadow-glow-gold-intense transition-all duration-150 transform hover:scale-105">
            Keep Playing
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
