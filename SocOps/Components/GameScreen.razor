@using SocOps.Models

<div class="flex flex-col min-h-full bg-space">
    <!-- Header -->
    <header class="flex items-center justify-between p-3 bg-space-light border-b border-glow-cyan">
        <button
            @onclick="OnReset"
            class="text-cyan-muted text-sm px-3 py-1.5 rounded hover:text-cyan transition-colors">
            ← Back
        </button>
        <h1 class="font-bold text-gold text-4xl glow-gold">Soc Ops</h1>
        <div class="w-16"></div>
    </header>

    <!-- Instructions -->
    <p class="text-center text-cyan-muted text-sm py-2 px-4">
        Tap a square when you find someone who matches it.
    </p>

    <!-- Bingo indicator -->
    @if (HasBingo)
    {
        <div class="bg-space-lighter text-gold text-center py-2 font-semibold text-sm border-t border-b border-glow-gold glow-gold">
            🎉 BINGO! You got a line!
        </div>
    }

    <!-- Board -->
    <div class="flex-1 flex items-center justify-center p-3">
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
