@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@(Square.IsFreeSpace ? "Free space" : Square.Text)">
    <span class="wrap-break-word hyphens-auto">@Square.Text</span>
    @if (Square.IsMarked && !Square.IsFreeSpace)
    {
        <span class="absolute top-0.5 right-0.5 text-cyan text-xs">✓</span>
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        var baseClasses = "relative flex items-center justify-center p-1 text-center rounded transition-all duration-150 select-none min-h-[60px] text-xs leading-tight font-medium";

        var stateClasses = Square.IsMarked
            ? IsWinning
                ? "bg-cyan border-2 border-gold text-gold animate-pulse-glow shadow-glow-cyan-intense"
                : "bg-gold border-2 border-cyan text-space font-bold shadow-glow-gold-intense"
            : "bg-space-lighter border-2 border-cyan text-cyan-light shadow-glow-cyan hover:border-cyan hover:shadow-glow-cyan-intense";

        var freeSpaceClasses = Square.IsFreeSpace ? "font-bold text-sm text-gold glow-gold" : "";

        return $"{baseClasses} {stateClasses} {freeSpaceClasses}";
    }
}
